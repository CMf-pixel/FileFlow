<Window x:Class="FileFlow.App.Views.RunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FileFlow.App.Views"
        Title="{Binding Title}" Width="900" Height="650" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Window_Closing" Loaded="Window_Loaded" Style="{StaticResource {x:Type Window}}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <StackPanel Margin="16,16,16,12">
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="Review the exact file operations before execution." Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="16,0">
            <views:PreviewView Visibility="{Binding ShowPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <views:ExecutionResultsView DataContext="{Binding Results}"
                                        Visibility="{Binding DataContext.HasResults, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Padding="16" Style="{StaticResource ErrorPanelStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620"
                    Visibility="{Binding HasUnexpectedError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Execution outcome unknown" Style="{StaticResource SectionTitleStyle}" Foreground="{DynamicResource ErrorBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource WindowBackgroundBrush}" Opacity="0.97"
                    Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                    <TextBlock Text="Processing files..." FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Preview.Operations.Count, StringFormat=Approved operations: {0}}"
                               Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,5,0,12" />
                    <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Processing files" />
                    <TextBlock Text="Please wait. FileFlow cannot close during execution."
                               Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="_Close" IsCancel="True" IsEnabled="{Binding CanClose}"
                        MinWidth="84" Margin="0,0,8,0" AutomationProperties.Name="Close run window" />
                <Button Content="_Execute" Command="{Binding ExecuteCommand}" MinWidth="92"
                        AutomationProperties.Name="Execute approved operations">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanExecute}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
